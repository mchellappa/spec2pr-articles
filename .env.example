# Dev.to (recommended — free API, works for all accounts)
# Get your key at: https://dev.to/settings/extensions → DEV Community API Keys
DEVTO_API_KEY=your_devto_api_key

# Medium (legacy — new integration tokens no longer issued as of 2025)
# Only set these if you already have a legacy token from before 2025
MEDIUM_TOKEN=your_medium_token
MEDIUM_USER_ID=your_medium_user_id
